{
  "expo": {
    "name": "就活ノート",
    "slug": "shukatsu-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "shukatsu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yourname.shukatsu",
      "supportsTablet": false
    },
    "android": {
      "package": "com.yourname.shukatsu",
      "adaptiveIcon": {
        "backgroundColor": "#2563EB"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
